DATABASE_URL=
DATABASE_PASSWORD=
SECRET_HASH=
JWT_HASH=

# Origin the browser comes back to after an OAuth login. The callback path is
# fixed by the route, so this is the only part that varies by deployment.
# Defaults to https://localhost when unset.
OAUTH_REDIRECT_BASE=https://localhost

# Configure only the providers you have registered an application with; the
# sign-in menu lists exactly those and the server boots fine without any.
# Each provider's redirect URI must be registered as:
#   <OAUTH_REDIRECT_BASE>/api/auth/<provider>/callback
# so with the default above: https://localhost/api/auth/42/callback
OAUTH_42_CLIENT_ID=
OAUTH_42_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
